// 节点的帮助窗口（像 Houdini 的帮助卡）：中键点节点、F1、参数面板头上的“?”打开。
// 浮在所有面板之上；拖标题栏移动、拖右下角改大小，Esc 或 ✕ 关闭。内容是 Rust 排好的一行行（HelpBlock，见 src/help.rs）。
import { ListView } from "std-widgets.slint";
import { Theme, Icons, HelpBlock } from "theme.slint";
import { IconButton } from "widgets.slint";

export component HelpWindow inherits Rectangle {
    in property <string> title;        // 类型名
    in property <string> desc;
    in property <string> category;     // 表格节点 · 行
    in property <int> cat;             // 分类的图标和颜色
    in property <string> badge;        // 用户 / 工程 / polars 生成…
    in property <[HelpBlock]> blocks;
    in property <bool> can-back;
    in property <int> page;            // 换了一页（Rust 加一）：滚回开头
    callback close();
    callback back();
    callback link(string);             // 点了相关节点
    callback drag(length, length);     // 拖标题栏：挪多少
    callback resize(length, length);   // 拖右下角：宽高变多少

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-strong;
    border-radius: 6px;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: Theme.shadow;
    clip: true;

    changed page => { lv.content-y = 0px; }

    // 吃掉落在窗口上的点击和滚轮，不传给下面的面板
    TouchArea {
        scroll-event(e) => { EventResult.accept }
    }

    VerticalLayout {
        // ---- 标题栏：拖动移动
        Rectangle {
            height: 30px;
            background: Theme.pane-head;
            drag-ta := TouchArea {
                mouse-cursor: move;
                moved => {
                    if (self.pressed) {
                        root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                if root.can-back: VerticalLayout {
                    alignment: center;
                    IconButton {
                        small: true;
                        icon: Icons.back;
                        clicked => { root.back(); }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: "  帮助";
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        small: true;
                        icon: Icons.close;
                        keys: "Esc";
                        clicked => { root.close(); }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
        }

        // ---- 头：图标、类型名、分类、来源标签、说明
        Rectangle {
            background: Theme.surface-alt;
            head := VerticalLayout {
                padding: 14px;
                padding-bottom: 12px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 9px;
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 22px;
                            height: 22px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.cat(root.cat);
                            stroke: Theme.cat(root.cat);
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            fill: transparent;
                        }
                    }
                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if root.badge != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 17px;
                            width: badge-txt.preferred-width + 14px;
                            border-radius: 8.5px;
                            background: Theme.chip-bg;
                            badge-txt := Text {
                                text: root.badge;
                                color: Theme.text;
                                font-size: 10.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.category;
                        color: Theme.text-faint;
                        font-size: 11.5px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Text {
                    text: root.desc;
                    color: Theme.text-muted;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }

        // ---- 正文：ListView 一行一行量高度（ScrollView + 布局量出来的总高度偏小，最后几行滚不到）。
        // 行里不用 if：每行只有一个占布局的 Text（样式按种类变），圆点、参数名、分隔线这些装饰按坐标画、不进布局
        lv := ListView {
            vertical-stretch: 1;
            for b[i] in root.blocks: row := Rectangle {
                property <length> left: 14px + (b.indent ? 18px : 0px);   // 这一行内容的左边（含页边）
                property <bool> boxed: b.kind == 4 || b.kind == 7;
                property <length> gap-top: (i == 0 ? 14px : 3px) + (b.kind == 1 ? 12px : 0px);
                property <length> gap-bottom: i == root.blocks.length - 1 ? 20px : 3px;

                // 底色：代码 / 这个节点的情况 / 链接悬停
                bg := Rectangle {
                    x: row.left;
                    y: row.gap-top;
                    width: row.width - row.left - 16px;
                    height: row.height - row.gap-top - row.gap-bottom;
                    background: b.kind == 4 ? Theme.field : b.kind == 7 ? Theme.accent-soft
                        : (b.kind == 6 && link-ta.has-hover ? Theme.hover : transparent);
                    border-radius: row.boxed || b.kind == 6 ? 4px : 0px;
                    border-width: b.kind == 4 ? 1px : 0px;
                    border-color: Theme.border;
                }

                // 左右的空用定宽的占位块，不用 padding（换行文字按格子实际的宽度量高度）
                HorizontalLayout {
                    padding-top: row.gap-top + (b.kind == 4 ? 7px : b.kind == 7 ? 10px : b.kind == 5 ? 5.5px : b.kind == 6 ? 4px : 0px);
                    padding-bottom: row.gap-bottom + (b.kind == 1 ? 5px : b.kind == 4 ? 7px : b.kind == 7 ? 10px : b.kind == 6 ? 4px : 0px);
                    Rectangle {
                        width: row.left + (b.kind == 3 ? 16px : b.kind == 4 ? 10px : b.kind == 7 ? 12px
                            : b.kind == 5 ? entry-label.preferred-width + 10px : b.kind == 6 ? 6px : 0px);
                    }
                    main := Text {
                        horizontal-stretch: 1;
                        text: b.kind == 6 ? b.label : b.text;
                        color: b.kind == 5 || b.kind == 8 ? Theme.text-faint : b.kind == 6 ? Theme.accent : Theme.text;
                        font-size: b.kind == 1 ? 14.5px : b.kind == 4 || b.kind == 5 || b.kind == 8 ? 11.5px
                            : b.kind == 7 ? 12px : 12.5px;
                        font-weight: b.kind == 1 || b.kind == 2 ? 600 : 400;
                        font-family: b.kind == 4 ? "Consolas" : "Microsoft YaHei UI";
                        // 代码按字符折行（polars 例子里画好的表格窗口够宽时不折）；相关节点的链接一行
                        wrap: b.kind == 4 ? TextWrap.char-wrap : b.kind == 6 ? TextWrap.no-wrap : TextWrap.word-wrap;
                    }
                    Rectangle {
                        width: 16px + (row.boxed ? 10px : 0px);
                    }
                }

                // 列表项的圆点
                Text {
                    visible: b.kind == 3;
                    x: row.left + 2px;
                    y: row.gap-top;
                    text: "•";
                    color: Theme.text-faint;
                    font-size: 12.5px;
                }
                // 参数条目的标签
                entry-label := Text {
                    visible: b.kind == 5;
                    x: row.left;
                    y: row.gap-top + 4px;
                    text: b.kind == 5 ? b.label : "";
                    color: Theme.focus;
                    font-size: 12.5px;
                    font-weight: 600;
                }
                // 节标题下面的线
                Rectangle {
                    visible: b.kind == 1;
                    x: row.left;
                    y: row.height - row.gap-bottom - 1px;
                    width: bg.width;
                    height: 1px;
                    background: Theme.border-strong;
                }
                // 这个节点的情况：左边一条
                Rectangle {
                    visible: b.kind == 7;
                    x: row.left;
                    y: bg.y;
                    width: 3px;
                    height: bg.height;
                    background: Theme.accent;
                }
                // 相关节点：说明在名字后面，点了跳过去
                link-desc := Text {
                    visible: b.kind == 6;
                    x: row.left + 6px + main.preferred-width + 14px;
                    y: bg.y;
                    width: max(0px, bg.x + bg.width - self.x - 6px);
                    height: bg.height;
                    text: b.kind == 6 ? b.text : "";
                    color: Theme.text-faint;
                    font-size: 11.5px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                link-ta := TouchArea {
                    x: bg.x;
                    y: bg.y;
                    width: bg.width;
                    height: bg.height;
                    enabled: b.kind == 6;
                    mouse-cursor: b.kind == 6 ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { root.link(b.label); }
                }
            }
        }
    }

    // 右下角：拖动改大小
    Rectangle {
        x: parent.width - 14px;
        y: parent.height - 14px;
        width: 14px;
        height: 14px;
        Path {
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M9 3 L3 9 M9 6 L6 9";
            stroke: Theme.text-faint;
            stroke-width: 1px;
        }
        TouchArea {
            mouse-cursor: nwse-resize;
            moved => {
                if (self.pressed) {
                    root.resize(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
    }
}
